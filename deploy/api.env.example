# Production settings of the API on intranet.jdh.local.
# Copy to ~/apps/platform/api.env (chmod 600) and fill it in. Never commit the real file.
# deploy/compose.prod.yaml sets DATABASE_URL, REDIS_URL, S3_*, ClamAV and ENVIRONMENT=prod.

# --- Dependencies of this compose project (any long random values) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_PASSWORD=

# --- Public origin (same origin as the UI behind Caddy) ---
CORS_ORIGINS=https://intranet.jdh.local
# Addresses or networks allowed to send X-Forwarded-For; empty = the subnet of the edge
# network (Caddy and the UI's server rendering), filled in by deploy.sh.
RATE_LIMIT_TRUSTED_PROXY_IPS=
LOG_LEVEL=INFO

# --- SSO with Entra (the intranet app registration, the same as the directory) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Empty scope: the registration exposes no API, so the session is the ID token (audience =
# client id) and sign-in asks for User.Read, as Better Auth did. With an exposed API, set
# ENTRA_API_AUDIENCE=api://<client id> and ENTRA_API_SCOPE=access_as_user instead.
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=
# Must be registered as a Web redirect URI in the app registration.
ENTRA_REDIRECT_URI=https://intranet.jdh.local/api/v1/auth/callback
# Where the browser lands after signing in (the UI has no callback page: the home).
AUTH_FRONTEND_REDIRECT_URI=https://intranet.jdh.local/
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_DEV_BYPASS=false
PLATFORM_OWNER_EMAIL=analista.ti@jdh.com.co

# --- Employee directory (intranet app registration, User.Read.All) ---
DIRECTORY_GRAPH_TENANT_ID=
DIRECTORY_GRAPH_CLIENT_ID=
DIRECTORY_GRAPH_CLIENT_SECRET=
DIRECTORY_SYNC_ENABLED=true
DIRECTORY_SYNC_AT=23:59
DIRECTORY_SYNC_TIMEZONE=America/Bogota
DIRECTORY_CORPORATE_DOMAINS=jdh.com.co

# --- Data warehouse (read-only, schema consumo) ---
DWH_ENABLED=true
DWH_HOST=
DWH_PORT=5432
DWH_DATABASE=
DWH_USER=
DWH_PASSWORD=
DWH_CURSOR_SECRET=

# --- Object storage links: the browser must reach this host (pending a Caddy route) ---
S3_PUBLIC_ENDPOINT_URL=

# --- PQRSF ---
PQRSF_UI_BASE_URL=https://intranet.jdh.local
PQRSF_NOTIFICATIONS_ENABLED=false
MAIL_INTAKE_ENABLED=false
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=

# --- Background loops ---
APP_MONITORING_ENABLED=true
DWH_MONITORING_SYNC_ENABLED=false
