# Runtime
APP_NAME=Internal Platform API
APP_VERSION=0.1.0
ENVIRONMENT=dev
DEBUG=true
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Microsoft Entra ID SSO (the frontend never stores tokens in localStorage)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=access_as_user
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AUTH_FRONTEND_REDIRECT_URI=http://localhost:3000/auth/callback-complete
# Development only. The API creates a local administrator without Entra.
AUTH_DEV_BYPASS=true
AUTH_DEV_USER_OBJECT_ID=development-user
AUTH_DEV_USER_EMAIL=developer@localhost
AUTH_DEV_USER_NAME=Development Administrator
# Optional deterministic development seed identities.
AUTH_DEV_SEED_ANALYST_EMAIL=analista.ti@jdh.com.co
AUTH_DEV_SEED_TENANT_ID=
AUTH_DEV_SEED_MOCK_PREFIX=development-mock
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/internal_platform
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_CONNECT_TIMEOUT_SECONDS=2

# Read-only datawarehouse provider (PostgreSQL, schema consumo)
DWH_ENABLED=true
DWH_PROVIDER=postgres
DWH_HOST=
DWH_PORT=5432
DWH_DATABASE=
DWH_USER=
DWH_PASSWORD=
DWH_SCHEMA=consumo
DWH_CLIENTS_VIEW=clientes
DWH_POOL_MIN_SIZE=1
DWH_POOL_MAX_SIZE=5
DWH_CONNECT_TIMEOUT_SECONDS=2
DWH_COMMAND_TIMEOUT_SECONDS=10
# Optional HMAC secret used to sign client pagination cursors
DWH_CURSOR_SECRET=

# Redis
REDIS_URL=redis://:redis@127.0.0.1:6379/0
REDIS_KEY_PREFIX=internal-platform
REDIS_DEFAULT_TTL_SECONDS=3600
REDIS_CONNECT_TIMEOUT_SECONDS=2
# Rate limit levels per client address; every endpoint has one (app/core/rate_policy.py):
# read = queries, relaxed = changes, strict = costly or open to the public.
RATE_LIMIT_READ_REQUESTS=600
RATE_LIMIT_READ_WINDOW_SECONDS=60
RATE_LIMIT_RELAXED_REQUESTS=120
RATE_LIMIT_RELAXED_WINDOW_SECONDS=60
RATE_LIMIT_STRICT_REQUESTS=5
RATE_LIMIT_STRICT_WINDOW_SECONDS=600
# Only these proxy peer IPs may provide X-Forwarded-For.
RATE_LIMIT_TRUSTED_PROXY_IPS=

# Public forms: one global budget per hour, body size cap and CAPTCHA (Turnstile, off when empty).
RATE_LIMIT_PUBLIC_GLOBAL_REQUESTS=100
RATE_LIMIT_PUBLIC_GLOBAL_WINDOW_SECONDS=3600
PUBLIC_MAX_BODY_MB=28
PUBLIC_CAPTCHA_SECRET=

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=internal-platform
S3_CONNECT_TIMEOUT_SECONDS=2
# Host used to sign download URLs; must be reachable from the browser.
# Empty = S3_ENDPOINT_URL (right when the API runs on the host).
S3_PUBLIC_ENDPOINT_URL=

# Document management
DOCUMENTS_MAX_UPLOAD_MB=25
DOCUMENTS_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,xlsm,csv,ppt,pptx,txt,png,jpg,jpeg,zip
DOCUMENTS_DOWNLOAD_URL_TTL_SECONDS=300

# Public PQRSF image uploads
PQRSF_MAX_ATTACHMENTS=5
PQRSF_MAX_ATTACHMENT_MB=5
PQRSF_MAX_TOTAL_ATTACHMENT_MB=25
PQRSF_MAX_IMAGE_PIXELS=20000000
PQRSF_CLAMAV_HOST=127.0.0.1
PQRSF_CLAMAV_PORT=3310
PQRSF_CLAMAV_TIMEOUT_SECONDS=10
# PQRSF follow-up: members of this area (plus admins) manage cases
PQRSF_MANAGER_AREA_SLUG=calidad
PQRSF_TIMEZONE=America/Bogota
PQRSF_HOLIDAYS_COUNTRY=CO
# Compose binds ClamAV only to loopback for host-run API development.
CLAMAV_HOST_PORT=3310

# PQRSF by email (Microsoft Graph, application permissions). Off by default.
# Needs Mail.Read/Mail.ReadWrite/Mail.Send on the app registration, scoped to
# the mailboxes with an Exchange Application Access Policy.
MAIL_INTAKE_ENABLED=false
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=
MAIL_PQRSF_INBOX=pqrsf@jdh.com.co
MAIL_IGNORED_SENDERS=info@jdh.com.co
# First sync only: take mail received from this ISO date-time (empty = from switch-on)
MAIL_INTAKE_SINCE=
MAIL_POLL_INTERVAL_SECONDS=120
MAIL_MAX_ATTEMPTS=5
MAIL_MAX_ATTACHMENTS=10
MAIL_MAX_ATTACHMENT_MB=10
MAIL_MAX_TOTAL_ATTACHMENT_MB=25
MAIL_ATTACHMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,txt,ppt,pptx,png,jpg,jpeg,webp

# PQRSF emails from the mailbox: assignment notices and the two timers (the times are
# set in the PQRSF settings panel). Needs the MAIL_GRAPH_* credentials above.
PQRSF_NOTIFICATIONS_ENABLED=false
PQRSF_UI_BASE_URL=http://localhost:3000
PQRSF_HOLIDAYS_API_URL=https://date.nager.at/api/v3
# Testing: send every PQRSF email to this address instead of its recipient
PQRSF_NOTIFY_REDIRECT=
# Automatic thank-yous one address can get per 24 hours (suggestions and compliments)
PQRSF_FEEDBACK_REPLIES_PER_EMAIL_PER_DAY=3
# Certificates sent automatically: area of the document manager they come from, emails with
# documents one address gets per 24 hours, and attachments per email.
PQRSF_CERTIFICATES_AREA_SLUG=calidad
PQRSF_DOCUMENT_EMAILS_PER_ADDRESS_PER_DAY=5
PQRSF_DOCUMENT_EMAIL_MAX_MB=15
# Members of this area (plus platform admins) create and edit supplier supports.
SUPPLIER_SUPPORTS_MANAGER_AREA_SLUG=comercial
# Rows per DWH page / upsert in scripts/sync-dwh-masters.py.
MASTERS_SYNC_BATCH_SIZE=2000

# Retained orders validator: members of this area (plus platform admins) upload the
# SIESA report and re-run validations; everyone signed in can read the results.
ORDER_VALIDATION_MANAGER_AREA_SLUG=comercial
ORDER_VALIDATION_MAX_UPLOAD_MB=10
ORDER_VALIDATION_MAX_LINES=10000

# Data warehouse monitoring (TI -> Monitoreo -> Datawarehouse): copies the warehouse
# monitoreo schema over the DWH_* connection every N seconds. Off until the schema exists.
DWH_MONITORING_SYNC_ENABLED=false
DWH_MONITORING_SYNC_INTERVAL_SECONDS=600

# Application monitoring (TI -> Monitoreo -> Aplicativos): requests the health endpoint and
# the UI of every registered platform every N seconds; checks are kept for N days.
APP_MONITORING_ENABLED=true
APP_MONITORING_INTERVAL_SECONDS=60
APP_MONITORING_RETENTION_DAYS=30

# Project manager: comma-separated areas where it is on; live presence lifetime
PROJECTS_AREA_SLUGS=ti
PROJECTS_PRESENCE_TTL_SECONDS=45

# Compose-only credentials (keep local values out of Git)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=internal_platform
REDIS_PASSWORD=redis
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional host port overrides when defaults are already in use
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
S3_HOST_PORT=9000
S3_CONSOLE_HOST_PORT=9001
API_HOST_PORT=8000

# Microsoft Entra ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
